# BFF Environment Configuration
# Copy this file to .env and fill in the values

# Environment
NODE_ENV=development
PORT=3000

# Core API URL (for proxying requests)
API_URL=http://api:8000

# Redis Configuration
REDIS_URL=redis://redis:6379

# Keycloak Configuration
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=Apps
KEYCLOAK_CLIENT_ID=kmplatform
KEYCLOAK_CLIENT_SECRET=your-client-secret-here

# Session Configuration
# Generate with: openssl rand -base64 32
SESSION_SECRET=your-session-secret-here-min-32-chars-long
SESSION_MAX_AGE=604800000

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://shell.kmp.local:5173

# Cookie Configuration
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Logging
LOG_LEVEL=debug

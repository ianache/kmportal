# Knowledge Management Center - Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# ================================================
# PostgreSQL - Relational metadata store
# ================================================
POSTGRES_USER=knowledge
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=knowledge_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ================================================
# MongoDB - Document content store
# ================================================
MONGO_USER=knowledge
MONGO_PASSWORD=change_me_in_production
MONGO_DB=knowledge_db
MONGO_HOST=mongodb
MONGO_PORT=27017

# ================================================
# ChromaDB - Vector store (MVP)
# ================================================
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# ================================================
# Redis - Session store & pub/sub
# ================================================
REDIS_HOST=redis
REDIS_PORT=6379

# ================================================
# Kafka - Message broker
# ================================================
KAFKA_HOST=kafka
KAFKA_PORT=9092

# ================================================
# RabbitMQ - Message broker
# ================================================
RABBITMQ_USER=knowledge
RABBITMQ_PASSWORD=change_me_in_production
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

# ================================================
# Keycloak - OAuth2/OIDC Provider (External)
# ================================================
# URL of the Keycloak server (no trailing slash)
KEYCLOAK_URL=https://oauth2.qa.comsatel.com.pe

# Keycloak realm name
KEYCLOAK_REALM=Apps

# Client ID for this application
KEYCLOAK_CLIENT_ID=kmplatform

# Client secret (only needed for confidential clients)
KEYCLOAK_CLIENT_SECRET=your_client_secret_here

# ================================================
# Gemini API - Embedding provider
# ================================================
# Get your API key from: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# Embedding model to use
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Gemini API embedding dimensions (768 for text-embedding-004)
EMBEDDING_DIMENSION=768

# Batch size for embedding requests (verify against Gemini limits)
EMBEDDING_BATCH_SIZE=100

# ================================================
# Application Settings
# ================================================
# Environment: development, staging, production
ENVIRONMENT=development

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Application version
VERSION=0.2.0

# Database URL (used by SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://knowledge:change_me_in_production@postgres:5432/knowledge_db

# Session secret for BFF (generate with: openssl rand -base64 32)
SESSION_SECRET=change_me_in_production_generate_a_secure_random_string

# ================================================
# API Configuration
# ================================================
# Core API host and port (internal)
API_HOST=api
API_PORT=8000

# BFF host and port
BFF_HOST=bff
BFF_PORT=3000

# ================================================
# Security Settings
# ================================================
# CORS origins (comma-separated)
# In production, specify exact origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# API Key rate limiting (requests per minute)
API_KEY_RATE_LIMIT=100

# Token expiration time (seconds)
ACCESS_TOKEN_EXPIRE=1800
REFRESH_TOKEN_EXPIRE=604800

# ================================================
# Feature Flags
# ================================================
# Enable/disable specific features
ENABLE_KAFKA_INGESTION=true
ENABLE_RABBITMQ_INGESTION=true
ENABLE_S3_INGESTION=false
ENABLE_FOLDER_WATCH=true

# ================================================
# Monitoring & Observability
# ================================================
# Enable structured JSON logging
ENABLE_JSON_LOGGING=false

# OpenTelemetry collector endpoint (optional)
# OTEL_COLLECTOR_URL=http://otel-collector:4317

# ================================================
# Development Only
# ================================================
# Hot reload for development
API_RELOAD=true

# Volume mount paths (only for local development)
DATA_PATH=./data
LOGS_PATH=./logs

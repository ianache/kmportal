# Production Environment Configuration
# Copy this file to .env and update with your actual values

# =============================================================================
# Application Settings
# =============================================================================
ENVIRONMENT=production
VERSION=1.0.0
LOG_LEVEL=INFO
JSON_LOGS=true

# =============================================================================
# Database Configuration
# =============================================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=knowledge
POSTGRES_PASSWORD=change_me_in_production_use_strong_password
POSTGRES_DB=knowledge_db
DATABASE_URL=postgresql+asyncpg://knowledge:change_me_in_production_use_strong_password@postgres:5432/knowledge_db

# =============================================================================
# MongoDB Configuration
# =============================================================================
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_USER=knowledge
MONGO_PASSWORD=change_me_in_production_use_strong_password
MONGO_DB=knowledge_db
MONGO_URL=mongodb://knowledge:change_me_in_production_use_strong_password@mongodb:27017/knowledge_db

# =============================================================================
# Vector Store Configuration (ChromaDB)
# =============================================================================
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_URL=http://chromadb:8000

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# =============================================================================
# Message Broker Configuration
# =============================================================================
# Kafka
KAFKA_HOST=kafka
KAFKA_PORT=29092
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=knowledge
RABBITMQ_PASSWORD=change_me_in_production_use_strong_password
RABBITMQ_URL=amqp://knowledge:change_me_in_production_use_strong_password@rabbitmq:5672/

# =============================================================================
# Authentication (Keycloak)
# =============================================================================
KEYCLOAK_URL=https://auth.yourdomain.com
KEYCLOAK_REALM=knowledge-management
KEYCLOAK_CLIENT_ID=knowledge-api
KEYCLOAK_CLIENT_SECRET=your_client_secret_here

# =============================================================================
# AI/ML Configuration
# =============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=text-embedding-004

# =============================================================================
# Security
# =============================================================================
SESSION_SECRET=generate_a_random_string_at_least_32_chars_long_for_sessions
CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# =============================================================================
# Monitoring & Observability
# =============================================================================
# Enable Prometheus metrics
ENABLE_METRICS=true
METRICS_PORT=9090

# OpenTelemetry (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=knowledge-api
OTEL_SERVICE_VERSION=1.0.0

# =============================================================================
# Performance Tuning
# =============================================================================
# Database pool size
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30

# API Workers
API_WORKERS=4

# Request timeout (seconds)
REQUEST_TIMEOUT=60

# =============================================================================
# Feature Flags
# =============================================================================
ENABLE_MCP=true
ENABLE_WEBSOCKET=true
ENABLE_API_KEY_AUTH=true

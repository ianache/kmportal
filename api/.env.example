# Knowledge Management API - Configuration Example
# Copy this file to .env and adjust values as needed

# ============================================
# EMBEDDING PROVIDER CONFIGURATION
# ============================================

# Provider selection: 'ollama', 'gemini', or 'mock'
# 'auto' will use Ollama if OLLAMA_HOST is set, otherwise Gemini if GEMINI_API_KEY is set, else mock
EMBEDDING_PROVIDER=ollama

# --- Ollama (Local) Configuration ---
# For local embedding generation using Ollama
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
OLLAMA_MODEL=embeddinggemma

# To use Ollama:
# 1. Install Ollama: https://ollama.com/
# 2. Pull the embedding model: ollama pull embeddinggemma
# 3. Start Ollama: ollama serve
# 4. Set EMBEDDING_PROVIDER=ollama

# --- Gemini (Cloud) Configuration ---
# For cloud-based embeddings using Google Gemini API
# GEMINI_API_KEY=your_api_key_here
# GEMINI_EMBEDDING_MODEL=text-embedding-004

# To use Gemini:
# 1. Get API key from: https://aistudio.google.com/app/apikey
# 2. Enable Generative Language API in Google Cloud Console
# 3. Set EMBEDDING_PROVIDER=gemini
# 4. Set GEMINI_API_KEY=your_key

# --- Mock (Testing) Configuration ---
# For testing without external services
# MOCK_EMBEDDING_DIMENSION=768

# ============================================
# DATABASE CONFIGURATION
# ============================================

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/knowledge_mgmt

# ============================================
# VECTOR STORE CONFIGURATION
# ============================================

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ============================================
# GRAPH DATABASE CONFIGURATION
# ============================================

# Neo4j
NEO4J_BOLT_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ============================================
# AUTHENTICATION CONFIGURATION
# ============================================

# Keycloak/OIDC
OIDC_ISSUER_URL=https://your-keycloak-server/realms/your-realm
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret

# ============================================
# APPLICATION CONFIGURATION
# ============================================

ENVIRONMENT=development
LOG_LEVEL=INFO
VERSION=0.2.0

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5100

# ============================================
# RATE LIMITING
# ============================================

RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ============================================
# FILE STORAGE
# ============================================

UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
